*.apk
*.aab
*.apks
*.idsig

# AI coding-agent tooling installed in this checkout (skills, agents, local config)
.claude/
.agent/
.agents/
.cursor/
.gemini/
.kiro/
.opencode/

# Impeccable design working files; keep only the design-system sidecar next to DESIGN.md
.impeccable/*
!.impeccable/design.json
